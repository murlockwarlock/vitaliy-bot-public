# Production deployment configuration template
# Copy to .env.deploy and fill in your infrastructure values
# WARNING: NEVER commit .env.deploy or real infrastructure details to git

PROD_HOST=your-server-ip-or-domain
PROD_USER=deploy-user
PROD_SSH_KEY=~/.ssh/your_deploy_key
PROD_REMOTE_DIR=/path/to/remote/vitaliy_bot
PROD_PM2_NAME=vitaliy_bot
PROD_PYTHON_BIN=/path/to/remote/venv/bin/python
PROD_BLOCKED_HOSTS=
